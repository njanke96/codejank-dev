    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "mdsvex": "^0.12.8",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.105.1",
